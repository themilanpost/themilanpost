# Public Formspree form id (not a secret). Create a form at https://formspree.io
# Set the notification/deliver-to email only in the Formspree dashboard (do not put it here).
# Then paste the id from https://formspree.io/f/xxxxxxxx
# Production Pages CI sets the same var in themilanpost/.github/workflows/deploy.yml
PUBLIC_FORMSPREE_FORM_ID=xwlkndra

# Cloudflare Worker URL for the vintage hit counter (no trailing slash).
# After: cd workers/hit-counter && npx wrangler deploy
# Example: https://themilanpost-hit-counter.<your-subdomain>.workers.dev
PUBLIC_HIT_COUNTER_URL=
