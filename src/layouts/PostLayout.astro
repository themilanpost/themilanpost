---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import GuideRelatedLinks from '../components/GuideRelatedLinks.astro';
import GuideFaq from '../components/GuideFaq.astro';
import { brand } from '../config/brand';
import { faqPageMainEntity, getGuideFaqs } from '../config/guide-faqs';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  date: Date;
  author?: string;
  articleSlug?: string;
  lang?: Lang;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  date,
  author = 'Team',
  articleSlug,
  lang = 'en',
  alternates = [],
} = Astro.props;

const formattedDate = date.toLocaleDateString(lang === 'it' ? 'it-IT' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? brand.url).href;
const faqBlock = getGuideFaqs(articleSlug);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: lang,
  datePublished: date.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: brand.name,
    url: brand.url,
  },
  mainEntityOfPage: pageUrl,
  image: new URL('/og-image.png', Astro.site ?? brand.url).href,
};

const guidesHref = lang === 'it' ? `${brand.url}/it/guides/` : `${brand.url}/guides/`;
const guidesLabel = lang === 'it' ? 'Guide' : 'Guides';
const homeLabel = lang === 'it' ? 'Home' : 'Home';
const backLabel = lang === 'it' ? 'Torna alle guide' : 'Back to Guides';
const backHref = lang === 'it' ? '/it/guides/' : '/guides/';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: lang === 'it' ? `${brand.url}/it/` : `${brand.url}/` },
    { '@type': 'ListItem', position: 2, name: guidesLabel, item: guidesHref },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const faqSchema = faqBlock
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: 'it',
      mainEntity: faqPageMainEntity(faqBlock.items),
    }
  : null;

// Italian FAQ block only on Italian pages (keeps EN guides English-primary)
const showFaq = Boolean(faqBlock && lang === 'it');

const schemaBlocks = [
  articleSchema,
  breadcrumbSchema,
  ...(showFaq && faqSchema ? [faqSchema] : []),
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  lang={lang}
  ogLocale={lang === 'it' ? brand.it.locale : brand.locale}
  alternates={alternates}
  schema={schemaBlocks}
>
  <Header slot="header" />

  <section class="bg-primary py-14 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-article px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-1.5 text-sm text-primary-fg/60">
          <li>
            <a href={lang === 'it' ? '/it/' : '/'} class="transition-colors hover:text-primary-fg">
              {homeLabel}
            </a>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <a href={backHref} class="transition-colors hover:text-primary-fg">{guidesLabel}</a>
          </li>
          <li class="flex items-center gap-1.5">
            <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
            <span aria-current="page" class="text-primary-fg">{title}</span>
          </li>
        </ol>
      </nav>

      <h1 class="font-heading text-h1 font-bold uppercase text-primary-fg">{title}</h1>
      <div class="mt-3 flex items-center gap-3 text-sm text-primary-fg/70">
        <span>{author}</span>
        <span aria-hidden="true">&bull;</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>
    </div>
  </section>

  <section class="py-section">
    <div class="mx-auto max-w-article px-4 sm:px-6">
      <article
        class="prose-article prose prose-lg max-w-none prose-headings:font-heading prose-headings:uppercase prose-a:text-primary-light hover:prose-a:text-primary"
        lang={lang}
      >
        <slot />
        {articleSlug && <GuideRelatedLinks articleSlug={articleSlug} lang={lang} />}
      </article>

      {showFaq && faqBlock && <GuideFaq faq={faqBlock} />}

      <div class="mt-10 border-t border-border pt-6">
        <a
          href={backHref}
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primary-light"
        >
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
          </svg>
          {backLabel}
        </a>
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
