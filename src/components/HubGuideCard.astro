---
interface Props {
  label: string;
  title: string;
  description: string;
  href: string;
  badge?: string;
  cta?: string;
}

const {
  label,
  title,
  description,
  href,
  badge = 'Hub ready',
  cta = 'Open hub',
} = Astro.props;
---

<a
  href={href}
  class="group flex h-full min-h-[220px] flex-col rounded-md border border-border bg-background p-5 shadow-sm transition-[border-color,box-shadow] hover:border-primary hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
>
  <div class="flex items-start justify-between gap-3">
    <p class="text-topper font-bold uppercase tracking-widest text-primary">{label}</p>
    <span class="shrink-0 rounded-sm bg-primary/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-primary">
      {badge}
    </span>
  </div>
  <h2 class="mt-3 font-heading text-h3 font-semibold text-text transition-colors group-hover:text-primary">
    {title}
  </h2>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary">
    {cta}
    <svg class="size-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
