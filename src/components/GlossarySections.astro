---
import type { GlossaryCategory } from '../config/glossary-types';

interface Props {
  categories: GlossaryCategory[];
}

const { categories } = Astro.props;
---

<nav class="mt-8 flex flex-wrap gap-2" aria-label="Glossary categories">
  {
    categories.map((cat) => (
      <a
        href={`#${cat.id}`}
        class="rounded-md border border-border bg-surface px-3 py-1.5 text-sm font-medium text-text-muted transition-colors hover:border-primary/30 hover:text-primary"
      >
        {cat.title}
      </a>
    ))
  }
</nav>

<div class="mt-12 space-y-14">
  {
    categories.map((category) => (
      <section id={category.id} class="scroll-mt-24">
        <h2 class="font-heading text-h2 font-semibold text-text">{category.title}</h2>
        <dl class="mt-6 divide-y divide-border rounded-lg border border-border bg-surface">
          {
            category.entries.map((entry) => (
              <div class="grid gap-1 px-5 py-4 sm:grid-cols-[minmax(0,11rem)_1fr] sm:gap-6">
                <dt class="font-heading text-base font-semibold text-text">{entry.term}</dt>
                <dd>
                  <p class="text-sm font-medium text-primary">{entry.english}</p>
                  <p class="mt-1.5 text-sm leading-relaxed text-text-muted">{entry.description}</p>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>
    ))
  }
</div>
