---
import {
  celebrityMilanPlaces,
  googleMapsSearchUrl,
  type CelebrityMilanPlace,
} from '../config/celebrity-milan-places';

interface Props {
  places?: CelebrityMilanPlace[];
  mapId?: string;
}

const places = Astro.props.places ?? celebrityMilanPlaces;
const mapId = Astro.props.mapId ?? 'celebrity-milan-places-map';

const markers = places.map((p) => ({
  id: p.id,
  name: p.name,
  blurb: p.blurb,
  celeb: p.celeb,
  lat: p.lat,
  lng: p.lng,
  mapsUrl: googleMapsSearchUrl(p.mapsQuery),
  address: p.address ?? '',
}));
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<div class="not-prose my-8 space-y-3">
  <p class="text-sm text-text-muted">
    Tap a pin (or a place below) to open it in Google Maps.
  </p>
  <div
    id={mapId}
    class="relative z-0 h-[min(70vh,520px)] w-full overflow-hidden rounded-lg border border-border bg-surface"
    role="region"
    aria-label="Map of celebrity-mentioned places in Milan"
  ></div>
  <ul class="grid gap-2 sm:grid-cols-2">
    {places.map((p) => (
      <li>
        <a
          href={googleMapsSearchUrl(p.mapsQuery)}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-md border border-border bg-surface px-3 py-2 text-sm transition-colors hover:border-primary hover:bg-primary/5"
        >
          <span class="font-semibold text-text">{p.name}</span>
          <span class="mt-0.5 block text-xs text-text-muted">{p.celeb}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<script is:inline define:vars={{ mapId, markers }}>
  (function initCelebrityPlacesMap() {
    const el = document.getElementById(mapId);
    if (!el || el.dataset.mapInit === 'true') return;
    el.dataset.mapInit = 'true';

    function boot() {
      if (typeof L === 'undefined') {
        setTimeout(boot, 40);
        return;
      }

      const map = L.map(el, { scrollWheelZoom: false });
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution:
          '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      const bounds = [];
      markers.forEach((m) => {
        const marker = L.marker([m.lat, m.lng]).addTo(map);
        marker.bindTooltip(`${m.name} — ${m.celeb}<br><em>Click to open Google Maps</em>`, {
          sticky: true,
        });
        marker.on('click', () => {
          window.open(m.mapsUrl, '_blank', 'noopener,noreferrer');
        });
        bounds.push([m.lat, m.lng]);
      });

      if (bounds.length) {
        map.fitBounds(bounds, { padding: [36, 36], maxZoom: 14 });
      }
    }

    if (typeof L !== 'undefined') {
      boot();
      return;
    }
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    s.integrity = 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
    s.crossOrigin = '';
    s.onload = boot;
    document.head.appendChild(s);
  })();
</script>
