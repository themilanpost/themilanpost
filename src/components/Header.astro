---
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { guidesNavFor, isGuidesNavActive } from '../config/guides-hub';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { localePath } from '../i18n/paths';
import LanguageSwitcher from './LanguageSwitcher.astro';
import logo from '../assets/branding/the-milan-post-logo.png';

const currentPath = Astro.url.pathname;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = localePath('/', lang);
/** NiM is EN-only (international community); omit from Italian chrome. */
const newInMilanHref = lang === 'en' ? '/new-in-milan' : null;
/** Full page load: pulse app must re-init (View Transitions skip module scripts). */
const trackerHref = localePath('/tracker', lang);
const guidesNavItems = guidesNavFor(lang);

const aboutNavItems = [
  { label: t('nav.about'), href: localePath('/about', lang) },
  { label: t('nav.contact'), href: localePath('/contact', lang) },
] as const;

function isLinkActive(href: string, path: string): boolean {
  return path === href || (href !== '/' && path.startsWith(href));
}

const aboutActive = aboutNavItems.some(({ href }) => isLinkActive(href, currentPath));
const guidesActive = isGuidesNavActive(currentPath);

const summaryClass = (active: boolean) =>
  [
    'nav-summary inline-flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 text-sm font-medium transition-colors',
    active ? 'bg-primary/10 text-primary' : 'text-text-muted hover:text-text',
  ].join(' ');

const menuPanelClass =
  'absolute right-0 top-full z-50 mt-1 min-w-[12rem] rounded-md border border-border bg-background py-1 shadow-md';

const mobileLinkClass = (href: string) =>
  [
    'block rounded-md px-3 py-3 text-base font-medium transition-colors',
    isLinkActive(href, currentPath)
      ? 'bg-primary/10 text-primary'
      : 'text-text-muted hover:bg-surface hover:text-text',
  ].join(' ');
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm">
  <div class="relative mx-auto flex max-w-site items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href={homeHref} class="inline-flex min-w-0 shrink items-center transition-opacity hover:opacity-85">
      <Image
        src={logo}
        alt={`${brand.name} logo`}
        width={300}
        height={69}
        loading="eager"
        class="h-8 w-auto max-w-[min(12.5rem,52vw)] sm:h-9 sm:max-w-[14rem]"
      />
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
    <LanguageSwitcher />

    <!-- Desktop: native <details> — no JS -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label={lang === 'it' ? 'Navigazione principale' : 'Primary navigation'}>
      {
        newInMilanHref && (
          <a
            href={newInMilanHref}
            aria-current={isLinkActive(newInMilanHref, currentPath) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isLinkActive(newInMilanHref, currentPath)
                ? 'bg-primary/10 text-primary'
                : 'text-text-muted hover:text-text',
            ]}
          >
            {t('nav.newInMilan')}
          </a>
        )
      }

      <a
        href={trackerHref}
        data-astro-reload
        aria-current={isLinkActive(trackerHref, currentPath) ? 'page' : undefined}
        class:list={[
          'rounded-md px-3 py-2 text-sm font-medium transition-colors',
          isLinkActive(trackerHref, currentPath)
            ? 'bg-primary/10 text-primary'
            : 'text-text-muted hover:text-text',
        ]}
      >
        {t('nav.tracker')}
      </a>

      <details class="relative" name="desktop-nav">
        <summary class={summaryClass(guidesActive)}>
          {t('nav.guides')}
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class={menuPanelClass} role="menu" aria-label={t('nav.guides')}>
          {
            guidesNavItems.map(({ label, href }) => (
              <a
                href={href}
                role="menuitem"
                class:list={[
                  'block px-4 py-2 text-sm transition-colors',
                  isLinkActive(href, currentPath)
                    ? 'bg-primary/10 font-medium text-primary'
                    : 'text-text hover:bg-surface',
                ]}
              >
                {label}
              </a>
            ))
          }
        </div>
      </details>

      <details class="relative" name="desktop-nav">
        <summary class={summaryClass(aboutActive)}>
          {t('nav.about')}
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </summary>
        <div class={menuPanelClass} role="menu" aria-label={t('nav.about')}>
          {
            aboutNavItems.map(({ label, href }) => (
              <a
                href={href}
                role="menuitem"
                class:list={[
                  'block px-4 py-2 text-sm transition-colors',
                  isLinkActive(href, currentPath)
                    ? 'bg-primary/10 font-medium text-primary'
                    : 'text-text hover:bg-surface',
                ]}
              >
                {label}
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <!-- Mobile: native <details> — survives View Transitions (no JS) -->
    <details class="group mobile-nav lg:hidden">
      <summary
        class="nav-summary inline-flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-md text-text-muted hover:bg-surface"
        aria-label={t('nav.menu')}
      >
        <svg
          class="size-6 group-open:hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg
          class="hidden size-6 group-open:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </summary>

      <div
        class="absolute inset-x-0 top-full z-50 border-b border-t border-border bg-background px-4 pb-6 pt-2 shadow-md"
      >
        <nav class="mx-auto flex max-w-site flex-col gap-1" aria-label={lang === 'it' ? 'Navigazione mobile' : 'Mobile navigation'}>
          {
            newInMilanHref && (
              <a href={newInMilanHref} class={mobileLinkClass(newInMilanHref)}>
                {t('nav.newInMilan')}
              </a>
            )
          }

          <a href={trackerHref} data-astro-reload class={mobileLinkClass(trackerHref)}>
            {t('nav.tracker')}
          </a>

          <div>
            <p class="px-3 pt-2 text-xs font-bold uppercase tracking-widest text-text-muted">{t('nav.guides')}</p>
            {
              guidesNavItems.map(({ label, href }) => (
                <a href={href} class={mobileLinkClass(href)}>
                  {label}
                </a>
              ))
            }
          </div>

          <div>
            <p class="px-3 pt-2 text-xs font-bold uppercase tracking-widest text-text-muted">{t('nav.about')}</p>
            {
              aboutNavItems.map(({ label, href }) => (
                <a href={href} class={mobileLinkClass(href)}>
                  {label}
                </a>
              ))
            }
          </div>
        </nav>
      </div>
    </details>
    </div>
  </div>
</header>

<style>
  .nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-summary::marker {
    content: '';
  }
</style>
