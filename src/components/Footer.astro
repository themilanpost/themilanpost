---
import { brand } from '../config/brand';
import RetroHitCounter from './RetroHitCounter.astro';

const year = new Date().getFullYear();

/** Top-level pages only: detail pages live inside each hub. */
const navCols = [
  {
    title: 'Explore',
    links: [
      { label: 'New in Milan', href: '/new-in-milan' },
      { label: 'Guides', href: '/guides' },
      { label: 'Paperwork', href: '/paperwork' },
      { label: 'Living in Milan', href: '/living-in-milan' },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
      { label: 'Privacy & copyright', href: '/privacy' },
    ],
  },
];
---

<footer class="border-t border-border bg-surface text-text-muted" transition:persist>
  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">

      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="font-heading text-lg font-bold uppercase tracking-wide text-primary">
          {brand.name}
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-text">
          {brand.tagline}
        </p>
      </div>

      {navCols.map((col) => (
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-text">{col.title}</h3>
          <ul class="mt-3 space-y-2">
            {col.links.map(({ label, href }) => (
              <li>
                <a href={href} class="text-sm transition-colors hover:text-primary">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-8 border-t border-border pt-8">
      <RetroHitCounter />

      <div class="flex w-full flex-col items-center justify-between gap-3 text-center text-sm sm:flex-row sm:text-left">
        <p>
          &copy; {year} {brand.name}.{' '}
          <a href="/privacy#copyright" class="font-medium text-text transition-colors hover:text-primary">
            All rights reserved
          </a>.
        </p>
        <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 sm:justify-end">
          <a href="/privacy" class="font-medium text-text transition-colors hover:text-primary">
            Privacy
          </a>
          <a href="/privacy#copyright" class="font-medium text-text transition-colors hover:text-primary">
            Copyright
          </a>
          <button
            type="button"
            data-embed-consent-reset
            class="font-medium text-text transition-colors hover:text-primary"
          >
            Embed settings
          </button>
          <span>
            Made with <span aria-hidden="true">❤️</span><span class="sr-only">love</span> by
            <a href="/" class="font-medium text-text transition-colors hover:text-primary">
              {brand.name}
            </a>
          </span>
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline data-astro-rerun>
  (() => {
    const SCRIPT_SRC = 'https://tally.so/widgets/embed.js';

    const ensureTally = (onReady) => {
      if (typeof Tally !== 'undefined') {
        onReady();
        return;
      }
      const existing = document.querySelector(`script[src="${SCRIPT_SRC}"]`);
      if (existing) {
        existing.addEventListener('load', onReady, { once: true });
        return;
      }
      const s = document.createElement('script');
      s.src = SCRIPT_SRC;
      s.async = true;
      s.onload = onReady;
      document.body.appendChild(s);
    };

    const openJoinPopup = (formId) => {
      ensureTally(() => {
        if (typeof Tally === 'undefined' || typeof Tally.openPopup !== 'function') return;
        Tally.openPopup(formId, {
          layout: 'modal',
          width: 700,
          overlay: true,
          hideTitle: true,
          doNotShowAfterSubmit: false,
        });
      });
    };

    if (document.documentElement.dataset.tallyJoinInit === 'true') return;
    document.documentElement.dataset.tallyJoinInit = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest('[data-tally-open]');
      if (!(trigger instanceof HTMLElement)) return;
      const formId = trigger.getAttribute('data-tally-open');
      if (!formId) return;
      event.preventDefault();
      openJoinPopup(formId);
    });
  })();
</script>
