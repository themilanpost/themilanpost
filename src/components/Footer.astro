---
import { brand } from '../config/brand';
import { getLangFromUrl } from '../i18n/utils';
import { localePath } from '../i18n/paths';
import RetroHitCounter from './RetroHitCounter.astro';

const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const homeHref = localePath('/', lang);
const tagline = lang === 'it' ? brand.it.tagline : brand.tagline;
const privacyHref = localePath('/privacy', lang);

/** Top-level pages only: detail pages live inside each hub. */
const navCols =
  lang === 'it'
    ? [
        {
          title: 'Esplora',
          links: [
            { label: 'Milan Tracker', href: '/it/tracker/' },
            { label: 'Guide', href: '/it/guides/' },
            { label: 'Documenti e pratiche', href: '/it/paperwork/' },
            { label: 'Vivere a Milano', href: '/it/living-in-milan/' },
          ],
        },
        {
          title: 'Il sito',
          links: [
            { label: 'Chi siamo', href: '/it/about/' },
            { label: 'Contatti', href: '/it/contact/' },
            { label: 'Privacy e copyright', href: '/it/privacy/' },
          ],
        },
      ]
    : [
        {
          title: 'Explore',
          links: [
            { label: 'New in Milan', href: '/new-in-milan' },
            { label: 'Milan Tracker', href: '/tracker/' },
            { label: 'Guides', href: '/guides' },
            { label: 'Paperwork', href: '/paperwork' },
            { label: 'Living in Milan', href: '/living-in-milan' },
          ],
        },
        {
          title: 'About',
          links: [
            { label: 'About', href: '/about' },
            { label: 'Contact', href: '/contact' },
            { label: 'Privacy & copyright', href: '/privacy' },
          ],
        },
      ];

const rightsLabel = lang === 'it' ? 'Tutti i diritti riservati' : 'All rights reserved';
const embedLabel = lang === 'it' ? 'Impostazioni embed' : 'Embed settings';
const madeWith = lang === 'it' ? 'Fatto con' : 'Made with';
const byLabel = lang === 'it' ? 'da' : 'by';
---

<footer class="border-t border-border bg-surface text-text-muted" transition:persist>
  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3">

      <div class="sm:col-span-2 lg:col-span-1">
        <a href={homeHref} class="font-heading text-lg font-bold uppercase tracking-wide text-primary">
          {brand.name}
        </a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-text">
          {tagline}
        </p>
      </div>

      {navCols.map((col) => (
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wider text-text">{col.title}</h3>
          <ul class="mt-3 space-y-2">
            {col.links.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="text-sm transition-colors hover:text-primary"
                  data-astro-reload={href.includes('/tracker') ? true : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center gap-8 border-t border-border pt-8">
      <RetroHitCounter />

      <div class="flex w-full flex-col items-center justify-between gap-3 text-center text-sm sm:flex-row sm:text-left">
        <p>
          &copy; {year} {brand.name}.{' '}
          <a href={`${privacyHref}#copyright`} class="font-medium text-text transition-colors hover:text-primary">
            {rightsLabel}
          </a>.
        </p>
        <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 sm:justify-end">
          <a href={privacyHref} class="font-medium text-text transition-colors hover:text-primary">
            Privacy
          </a>
          <a href={`${privacyHref}#copyright`} class="font-medium text-text transition-colors hover:text-primary">
            Copyright
          </a>
          <button
            type="button"
            data-embed-consent-reset
            class="font-medium text-text transition-colors hover:text-primary"
          >
            {embedLabel}
          </button>
          <span>
            {madeWith} <span aria-hidden="true">❤️</span><span class="sr-only">{lang === 'it' ? 'amore' : 'love'}</span> {byLabel}
            <a href={homeHref} class="font-medium text-text transition-colors hover:text-primary">
              {brand.name}
            </a>
          </span>
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline data-astro-rerun>
  (() => {
    const SCRIPT_SRC = 'https://tally.so/widgets/embed.js';

    const ensureTally = (onReady) => {
      if (typeof Tally !== 'undefined') {
        onReady();
        return;
      }
      const existing = document.querySelector(`script[src="${SCRIPT_SRC}"]`);
      if (existing) {
        existing.addEventListener('load', onReady, { once: true });
        return;
      }
      const s = document.createElement('script');
      s.src = SCRIPT_SRC;
      s.async = true;
      s.onload = onReady;
      document.body.appendChild(s);
    };

    const openJoinPopup = (formId) => {
      ensureTally(() => {
        if (typeof Tally === 'undefined' || typeof Tally.openPopup !== 'function') return;
        Tally.openPopup(formId, {
          layout: 'modal',
          width: 700,
          overlay: true,
          hideTitle: true,
          doNotShowAfterSubmit: false,
        });
      });
    };

    if (document.documentElement.dataset.tallyJoinInit === 'true') return;
    document.documentElement.dataset.tallyJoinInit = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest('[data-tally-open]');
      if (!(trigger instanceof HTMLElement)) return;
      const formId = trigger.getAttribute('data-tally-open');
      if (!formId) return;
      event.preventDefault();
      openJoinPopup(formId);
    });
  })();
</script>
