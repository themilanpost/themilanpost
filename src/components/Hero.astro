---
/**
 * Full-bleed atmospheric homepage hero.
 * Brand + one headline + one supporting line + one CTA over Milan photography.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import { heroImageCredit } from '../config/images';
import localHeroImage from '../assets/images/hero/milan-bridge.jpg';

interface Props {
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const {
  heading = 'Practical guides for building your life in Milan.',
  description =
    'Paperwork, housing, healthcare, transport, and everyday life — written for newcomers.',
  ctaLabel = 'Browse guides',
  ctaHref = '/guides',
  imageSrc = localHeroImage,
  imageAlt = 'Bridge over a canal with buildings in Milan',
} = Astro.props;

const isLocal = typeof imageSrc !== 'string';
---

<section
  class="hero-atmosphere relative flex min-h-[min(92vh,52rem)] items-end overflow-hidden bg-dark text-primary-fg"
  aria-label="Introduction"
>
  <!-- Full-bleed photo plane -->
  <div class="absolute inset-0" aria-hidden="true">
    {
      isLocal && imageSrc ? (
        <Image
          src={imageSrc}
          alt=""
          width={2400}
          height={1891}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-atmosphere__photo size-full object-cover object-center"
        />
      ) : (
        <img
          src={typeof imageSrc === 'string' ? imageSrc : ''}
          alt=""
          width={2400}
          height={1891}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="hero-atmosphere__photo size-full object-cover object-center"
        />
      )
    }
    <!-- Readable gradient: dark bottom/left, photo remains the visual -->
    <div
      class="absolute inset-0 bg-linear-to-t from-dark/90 via-dark/45 to-dark/20 sm:bg-linear-to-r sm:from-dark/85 sm:via-dark/40 sm:to-dark/10"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-site px-4 pb-14 pt-28 sm:px-6 sm:pb-16 md:pb-20 md:pt-32">
    <div class="max-w-2xl">
      <p
        class="hero-atmosphere__reveal hero-atmosphere__reveal--1 font-heading text-h2 font-semibold tracking-tight text-primary-fg sm:text-h1"
      >
        {brand.name}
      </p>

      <h1
        class="hero-atmosphere__reveal hero-atmosphere__reveal--2 mt-4 font-heading text-display font-semibold leading-[1.05] tracking-tight text-primary-fg"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <p
        class="hero-atmosphere__reveal hero-atmosphere__reveal--3 mt-5 max-w-xl text-lead leading-relaxed text-primary-fg/85"
      >
        {description}
      </p>

      <div class="hero-atmosphere__reveal hero-atmosphere__reveal--4 mt-8">
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {ctaLabel}
        </a>
      </div>

      {
        heroImageCredit ? (
          <p class="hero-atmosphere__reveal hero-atmosphere__reveal--5 mt-10 text-xs text-primary-fg/55">
            <a
              href={heroImageCredit.href}
              target="_blank"
              rel="noopener noreferrer"
              class="underline decoration-primary-fg/30 underline-offset-2 transition-colors hover:text-primary-fg/80 hover:decoration-primary-fg/60"
            >
              {heroImageCredit.label}
            </a>
          </p>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .hero-atmosphere__photo {
    animation: hero-photo-settle 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-atmosphere__reveal {
    animation: hero-rise 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-atmosphere__reveal--1 {
    animation-delay: 0.12s;
  }
  .hero-atmosphere__reveal--2 {
    animation-delay: 0.24s;
  }
  .hero-atmosphere__reveal--3 {
    animation-delay: 0.36s;
  }
  .hero-atmosphere__reveal--4 {
    animation-delay: 0.48s;
  }
  .hero-atmosphere__reveal--5 {
    animation-delay: 0.6s;
  }

  @keyframes hero-photo-settle {
    from {
      transform: scale(1.06);
      opacity: 0.7;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-atmosphere__photo,
    .hero-atmosphere__reveal {
      animation: none;
    }
  }
</style>
