---
import { relatedGuidesFor, type GuideLink } from '../config/guide-related-links';
import type { Lang } from '../i18n/ui';

interface Props {
  articleSlug: string;
  lang?: Lang;
}

const { articleSlug, lang = 'en' } = Astro.props;
const links: GuideLink[] = relatedGuidesFor(articleSlug, lang);

if (links.length === 0) return;

const heading = lang === 'it' ? 'Guide collegate' : 'Related guides';
const hubHref = lang === 'it' ? '/it/paperwork/' : '/paperwork/';
const hubLabel = lang === 'it' ? 'hub Documenti e pratiche' : 'Paperwork in Milan hub';
const footerLead =
  lang === 'it' ? 'Vedi tutti i temi sul' : 'Browse all paperwork topics on the';
---

<aside
  class="not-prose mt-12 rounded-lg border border-border bg-surface p-6"
  aria-label={heading}
>
  <h2 class="font-heading text-lg font-semibold uppercase tracking-wide text-text">
    {heading}
  </h2>
  <ul class="mt-4 space-y-2">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex flex-wrap items-baseline gap-x-2 font-semibold text-primary transition-colors hover:text-primary-light"
          >
            <span>{link.title}</span>
            {link.hub && (
              <span class="text-xs font-normal uppercase tracking-wide text-text-muted">
                {link.hub}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-sm text-text-muted">
    {footerLead}{' '}
    <a href={hubHref} class="font-semibold text-primary hover:text-primary-light">
      {hubLabel}
    </a>
    .
  </p>
</aside>
