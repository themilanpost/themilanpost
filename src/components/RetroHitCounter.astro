---
/**
 * Early-2000s visitor counter.
 * Counts via Cloudflare Worker + KV (PUBLIC_HIT_COUNTER_URL). Falls back to 000042 if unset/offline.
 */
const hitCounterUrl = (import.meta.env.PUBLIC_HIT_COUNTER_URL ?? '').replace(/\/$/, '');
---

<div class="retro-hit-counter" aria-live="polite">
  <p class="retro-hit-counter__eyebrow">✦ site traffic ✦</p>
  <div class="retro-hit-counter__bezel">
    <div class="retro-hit-counter__screen">
      <span class="retro-hit-counter__label">you are visitor</span>
      <span
        class="retro-hit-counter__digits"
        id="retro-hit-digits"
        data-fallback="000042"
        data-endpoint={hitCounterUrl}
      >000042</span>
    </div>
  </div>
  <p class="retro-hit-counter__fine">no cookies · number go up</p>
</div>

<style>
  .retro-hit-counter {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    font-family: 'Courier New', Courier, monospace;
    user-select: none;
  }

  .retro-hit-counter__eyebrow {
    margin: 0;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #666;
  }

  .retro-hit-counter__bezel {
    padding: 3px;
    border-radius: 6px;
    background: linear-gradient(180deg, #e8e8e8 0%, #9a9a9a 45%, #c4c4c4 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .retro-hit-counter__screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    min-width: 9.5rem;
    padding: 0.45rem 0.75rem 0.55rem;
    border-radius: 4px;
    background: #161616;
    box-shadow: inset 0 2px 8px rgba(0, 0, 0, 0.65);
  }

  .retro-hit-counter__label {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #5a5a5a;
  }

  .retro-hit-counter__digits {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    line-height: 1;
    color: #76ff03;
    text-shadow:
      0 0 6px rgba(118, 255, 3, 0.85),
      0 0 14px rgba(118, 255, 3, 0.45);
    font-variant-numeric: tabular-nums;
  }

  .retro-hit-counter__fine {
    margin: 0;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: #888;
  }
</style>

<script is:inline data-astro-rerun>
  (() => {
    const SESSION_KEY = 'tmp-hit-counted';

    const updateDigits = (display) => {
      const el = document.getElementById('retro-hit-digits');
      if (el) el.textContent = display;
    };

    const syncCounter = async () => {
      const el = document.getElementById('retro-hit-digits');
      const endpoint = el?.dataset?.endpoint?.trim() || '';
      if (!endpoint) {
        if (el?.dataset?.fallback) updateDigits(el.dataset.fallback);
        return;
      }

      const alreadyCounted = sessionStorage.getItem(SESSION_KEY) === '1';
      const action = alreadyCounted ? 'get' : 'hit';

      try {
        const res = await fetch(`${endpoint}?action=${action}`, {
          method: 'GET',
          headers: { Accept: 'application/json' },
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const data = await res.json();
        if (data?.display) {
          updateDigits(data.display);
          if (action === 'hit') sessionStorage.setItem(SESSION_KEY, '1');
        }
      } catch {
        if (el?.dataset?.fallback) updateDigits(el.dataset.fallback);
      }
    };

    document.addEventListener('astro:page-load', syncCounter);
    syncCounter();
  })();
</script>
