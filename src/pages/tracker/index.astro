---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { brand } from '../../config/brand';
import { localePath } from '../../i18n/paths';
import { getTrackerPageSummary } from '../../lib/milan-pulse-summary';

const title = 'Milan Tracker';
const description =
  'Track what is on in Milan today — listings, ATM alerts, and transport strikes. Part of The Milan Post.';
const alternates = [
  { hreflang: 'en', href: new URL('/tracker/', brand.url).href },
  { hreflang: 'it', href: new URL('/it/tracker/', brand.url).href },
  { hreflang: 'x-default', href: new URL('/tracker/', brand.url).href },
];
const summary = getTrackerPageSummary('en');
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  ogLocale={brand.locale}
  alternates={alternates}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/milan-pulse/pulse.css" />
    <link rel="preload" href="/data/milan-pulse/today.json" as="fetch" crossorigin />
    <link rel="preload" href="/data/milan-pulse/mobility.json" as="fetch" crossorigin />
    <link rel="preload" href="/data/milan-pulse/strikes-milan.json" as="fetch" crossorigin />
    <!-- Tracker is always light (TMP brand); undo site dark-mode FOUC if present. -->
    <script is:inline>
      document.documentElement.classList.remove('dark-mode', 'dark');
    </script>
  </Fragment>

  <div id="milan-pulse" class="milan-pulse-root" data-initial-lang="en">
    <div class="page">
      <header class="brand">
        <div class="brand-kicker">The Milan Post</div>
        <h1>Milan Tracker</h1>
        <p class="brand-sub">What’s on today — and can you actually get there?</p>
      </header>

      <section class="ssr-summary" aria-label="Tracker snapshot" id="milan-pulse-ssr">
        <h2 class="ssr-summary-heading">Today’s snapshot</h2>
        <ul class="ssr-summary-list">
          {summary.bullets.map((line) => <li>{line}</li>)}
        </ul>
        <p class="ssr-summary-sources-label">Sources</p>
        <ul class="ssr-summary-sources">
          {
            summary.sources.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="ssr-summary-disclaimer">{summary.disclaimer}</p>
        <p class="empty" id="milan-pulse-boot">Loading interactive tracker…</p>
      </section>
    </div>
  </div>

  <noscript>
    <div class="mx-auto max-w-md px-4 py-10 text-sm text-text-muted">
      <p class="font-semibold text-text">Milan Tracker snapshot (JavaScript off)</p>
      <ul class="mt-3 list-disc space-y-1 pl-5">
        {summary.bullets.map((line) => <li>{line}</li>)}
      </ul>
      <p class="mt-4">{summary.disclaimer}</p>
      <p class="mt-4">
        <a class="text-primary" href={localePath('/', 'en')}>Back to The Milan Post</a>
      </p>
    </div>
  </noscript>
</BaseLayout>

<style is:global>
  body:has(#milan-pulse) {
    margin: 0;
    background: #f4f4f5;
  }
  .ssr-summary {
    margin: 0;
    padding: 1rem 1.1rem;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    background: #ffffff;
    max-width: 40rem;
  }
  .ssr-summary-heading {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    font-weight: 700;
    color: #1a1a1a;
  }
  .ssr-summary-list {
    margin: 0;
    padding-left: 1.15rem;
    color: #444;
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .ssr-summary-sources-label {
    margin: 0.85rem 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888;
  }
  .ssr-summary-sources {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.85rem;
  }
  .ssr-summary-sources a {
    color: #c45c26;
  }
  .ssr-summary-disclaimer {
    margin: 0.85rem 0 0;
    font-size: 0.8rem;
    color: #666;
    line-height: 1.4;
  }
</style>

<script>
  import '../../scripts/milan-pulse/main.js';
</script>
