---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WeeklyMarketsExplorer from '../../components/WeeklyMarketsExplorer.astro';
import { livingHub } from '../../config/living-hubs';
import {
  COVERED_MARKETS_DATASET_PAGE,
  FARE_IMPRESA_MARKETS_PAGE,
  FARE_IMPRESA_MARKETS_PDF,
  WEEKLY_MARKETS_DATASET_PAGE,
  fetchWeeklyMarketsGeoJson,
} from '../../lib/weekly-markets-data';

const pageTitle = 'Weekly street markets in Milan';
const description =
  'Find open-air mercati rionali by day and municipio, interactive map from Comune open data, plus hours and practical tips for newcomers.';

let marketData: Awaited<ReturnType<typeof fetchWeeklyMarketsGeoJson>> | null = null;

try {
  marketData = await fetchWeeklyMarketsGeoJson();
} catch {
  marketData = null;
}

const datasetDate = marketData?.datasetModified
  ? new Date(marketData.datasetModified).toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={pageTitle} description={description}>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/living-in-milan" class="transition-colors hover:text-primary">{livingHub.title}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-text">Markets</li>
        </ol>
      </nav>

      <p class="text-topper font-bold uppercase tracking-widest text-primary">Living in Milan</p>
      <h1 class="mt-3 max-w-3xl font-heading text-h1 font-semibold text-text">{pageTitle}</h1>
      <p class="mt-4 max-w-2xl text-lead leading-relaxed text-text-muted">
        Scope: <strong>Comune di Milano</strong>: weekly open-air markets (<em>mercati settimanali scoperti</em>).
        Verified against Fare Impresa Milano and DS291 open data{datasetDate ? ` (${datasetDate})` : ''}.
      </p>

      <div class="prose prose-lg mt-10 max-w-none prose-headings:font-heading prose-a:text-primary-light">
        <h2>What they are</h2>
        <p>
          <strong>Mercati settimanali scoperti</strong> are temporary street markets on public space, stalls along a
          road or around a piazza, set up in the morning and cleared in the early afternoon. The Comune lists
          <strong>93 markets</strong> (some on a fortnightly schedule) with about <strong>9,687 stalls</strong> across
          roughly 54,000 m² (<a href={FARE_IMPRESA_MARKETS_PAGE}>Fare Impresa Milano, Mercati settimanali scoperti</a>).
        </p>
        <p>
          They are <strong>not</strong> the same as <strong>mercati comunali coperti</strong>, fixed indoor halls open
          most weekdays. For those, see our{' '}
          <a href="/living-in-milan/maps#covered-markets">covered markets map</a> (DS2471).
        </p>

        <h2>Find a market today</h2>
        <p>
          The map below uses Comune open data (DS291). Pick a weekday (defaults to <strong>today</strong>), optionally
          filter by <strong>municipio</strong>, then tap a list row or map area for hours and Google Maps directions.
        </p>

        {
          marketData ? (
            <WeeklyMarketsExplorer geojson={marketData.geojson} />
          ) : (
            <p class="rounded-md border border-border bg-background p-4 text-sm text-text-muted not-prose">
              Map temporarily unavailable. Use the{' '}
              <a href={FARE_IMPRESA_MARKETS_PAGE}>Comune geoportale</a> or{' '}
              <a href={WEEKLY_MARKETS_DATASET_PAGE}>DS291 dataset</a>.
            </p>
          )
        }

        <h2>Typical hours</h2>
        <p>
          Hours vary by market. The Comune&apos;s official ubicazioni PDF (August 2025) lists per-market times; patterns
          below are the usual rule of thumb. Always check the popup or PDF for your market.
        </p>
        <table>
          <thead>
            <tr>
              <th>Day</th>
              <th>Usual hours</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Monday-Friday</td>
              <td>From ~7:30, close ~14:00</td>
              <td>Stalls dismantle during early afternoon (<em>sgombero</em>)</td>
            </tr>
            <tr>
              <td>Saturday</td>
              <td>From ~7:30</td>
              <td>
                Larger markets (e.g. Papiniano, Fauchè) often until ~18:00; smaller ones may close at ~14:00 (see PDF)
              </td>
            </tr>
            <tr>
              <td>Sunday</td>
              <td>Very few markets</td>
              <td>Only a handful in DS291: use the Sun filter above</td>
            </tr>
          </tbody>
        </table>

        <h2>Make the trip worth it</h2>
        <ul>
          <li>
            <strong>Arrive mid-morning</strong>: first and last 30 minutes are setup and pack-down; produce is fullest
            between ~9:00 and 12:00 (common local pattern; not an official rule).
          </li>
          <li>
            <strong>Bring cash and a bag</strong>: many stalls take cards now, but cash still speeds small purchases;
            vendors often lack bags.
          </li>
          <li>
            <strong>Food vs non-food</strong>: DS291 separates <em>posteggi alimentari</em> and{' '}
            <em>non alimentari</em> (clothing, household). Stall counts are in each map popup.
          </li>
          <li>
            <strong>Same street, different day</strong>: each market runs on fixed weekday(s); use the day toggle rather
            than guessing from street names.
          </li>
          <li>
            <strong>Rain</strong>: outdoor markets may be shortened or cancelled; no city-wide live status feed, check
            locally or go early.
          </li>
        </ul>

        <h2>Other official maps</h2>
        <table>
          <thead>
            <tr>
              <th>Tool</th>
              <th>Best for</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <strong>This page</strong>: DS291 filter by day + municipio
              </td>
              <td>&ldquo;What&apos;s open today near my municipio?&rdquo;</td>
            </tr>
            <tr>
              <td>
                <a href={FARE_IMPRESA_MARKETS_PAGE}>Fare Impresa: Geoportale mappa</a>
              </td>
              <td>Comune polygon map with municipio, hours, and stall counts (click-through from official portal)</td>
            </tr>
            <tr>
              <td>
                <a href={FARE_IMPRESA_MARKETS_PDF}>Ubicazioni, orari, organico posteggi (PDF)</a>
              </td>
              <td>Printable list by day: authoritative hours per market</td>
            </tr>
            <tr>
              <td>
                <a href="/living-in-milan/maps#covered-markets">Milan maps: covered markets (DS2471)</a>
              </td>
              <td>Indoor mercati comunali: different opening pattern (weekday shops)</td>
            </tr>
          </tbody>
        </table>

        <h2>Quick checklist</h2>
        <ul>
          <li>✅ Open this page and confirm <strong>today&apos;s</strong> weekday is selected</li>
          <li>✅ Set <strong>municipio</strong> if you want markets near home</li>
          <li>✅ Tap a market → <strong>Open in Google Maps</strong> for walking directions</li>
          <li>✅ Plan for <strong>morning</strong> on Mon-Fri; Saturday hours vary. Check popup or PDF</li>
          <li>✅ Need a fixed indoor market? Use <a href="/living-in-milan/maps#covered-markets">covered markets map</a></li>
        </ul>

        <h2>Official links</h2>
        <table>
          <thead>
            <tr>
              <th>Resource</th>
              <th>URL</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Fare Impresa: mercati settimanali scoperti</td>
              <td><a href={FARE_IMPRESA_MARKETS_PAGE}>fareimpresa.comune.milano.it</a></td>
            </tr>
            <tr>
              <td>Ubicazioni / orari PDF (Aug 2025)</td>
              <td><a href={FARE_IMPRESA_MARKETS_PDF}>MSS ubicazioni orari organico</a></td>
            </tr>
            <tr>
              <td>Open data: DS291 GeoJSON</td>
              <td><a href={WEEKLY_MARKETS_DATASET_PAGE}>dati.comune.milano.it: DS291</a></td>
            </tr>
            <tr>
              <td>Open data: covered markets DS2471</td>
              <td><a href={COVERED_MARKETS_DATASET_PAGE}>dati.comune.milano.it: DS2471</a></td>
            </tr>
          </tbody>
        </table>

        <h2>Sources</h2>
        <ul>
          <li><a href={FARE_IMPRESA_MARKETS_PAGE}>Comune di Milano: Fare Impresa, Mercati settimanali scoperti</a></li>
          <li><a href={FARE_IMPRESA_MARKETS_PDF}>Comune di Milano: MSS ubicazioni, orari, organico posteggi (PDF, Aug 2025)</a></li>
          <li><a href={WEEKLY_MARKETS_DATASET_PAGE}>Comune di Milano: DS291 mercati settimanali scoperti</a></li>
          <li><a href={COVERED_MARKETS_DATASET_PAGE}>Comune di Milano: DS2471 mercati comunali coperti</a></li>
        </ul>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
