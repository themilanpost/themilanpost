---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GeoJsonMap from '../../components/GeoJsonMap.astro';
import GoogleMapsCollection from '../../components/GoogleMapsCollection.astro';
import MilanMapPanel from '../../components/MilanMapPanel.astro';
import { livingHub } from '../../config/living-hubs';
import { milanExternalMaps, milanMapCategories } from '../../config/milan-maps';
import { milanEmbeddedMaps } from '../../config/milan-embedded-maps';
import { milanGoogleCollections } from '../../config/milan-google-collections';
import { fetchComuneGeoJson } from '../../lib/comune-geojson';
import { getGoogleMapsCollectionBundle } from '../../lib/google-maps-collection';

const pageTitle = 'Milan maps';
const description =
  'Milan open-data maps, Google Maps collections, and official links — fountains, metro, markets, pharmacies, recycling.';

interface LoadedEmbed {
  config: (typeof milanEmbeddedMaps)[number];
  points: Awaited<ReturnType<typeof fetchComuneGeoJson>> | null;
  lines: Awaited<ReturnType<typeof fetchComuneGeoJson>> | null;
  error: string | null;
}

interface LoadedGoogleCollection {
  config: (typeof milanGoogleCollections)[number];
  bundle: ReturnType<typeof getGoogleMapsCollectionBundle>;
}

const embeddedByCategory = milanMapCategories.map((category) => ({
  category,
  embeds: milanEmbeddedMaps.filter((m) => m.category === category),
  external: milanExternalMaps.filter((m) => m.category === category),
}));

const loadedEmbeds: LoadedEmbed[] = await Promise.all(
  milanEmbeddedMaps.map(async (config) => {
    try {
      const points = await fetchComuneGeoJson(config.packageId);
      const lines = config.linePackageId
        ? await fetchComuneGeoJson(config.linePackageId)
        : null;
      return { config, points, lines, error: null };
    } catch (err) {
      return {
        config,
        points: null,
        lines: null,
        error: err instanceof Error ? err.message : 'Could not load map data.',
      };
    }
  }),
);

const embedById = Object.fromEntries(loadedEmbeds.map((e) => [e.config.id, e]));

const loadedGoogleCollections: LoadedGoogleCollection[] = milanGoogleCollections.map((config) => ({
  config,
  bundle: getGoogleMapsCollectionBundle(config.mapId, config.center, config.zoom),
}));

---

<BaseLayout title={pageTitle} description={description}>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><a href="/" class="transition-colors hover:text-primary">Home</a></li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/living-in-milan" class="transition-colors hover:text-primary">{livingHub.title}</a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-text">Maps</li>
        </ol>
      </nav>

      <p class="text-topper font-bold uppercase tracking-widest text-primary">Living in Milan</p>
      <h1 class="mt-3 max-w-3xl font-heading text-h1 font-semibold text-text">{pageTitle}</h1>
      <p class="mt-4 max-w-2xl text-lead leading-relaxed text-text-muted">
        Embedded maps from Comune open data (Leaflet) and public Google My Maps collections, plus official
        external tools where live data is required (route planner, on-duty pharmacies, PDF schematics).
      </p>

      <div
        class="mt-10 rounded-lg border border-border bg-surface p-5 sm:p-8"
        aria-labelledby="maps-section-title"
      >
        <h2 id="maps-section-title" class="font-heading text-h2 font-semibold text-text">Maps</h2>

        {
          loadedGoogleCollections.length > 0 ? (
            <div class="mt-8">
              <h3 class="font-heading text-lg font-semibold text-text">Google Maps collections</h3>
              <p class="mt-2 max-w-2xl text-sm text-text-muted">
                Public My Maps layers: after you accept optional embeds (or click Load), maps show on
                Google&apos;s base map. You can also use &ldquo;Open map&rdquo;.
              </p>
              <div class="mt-4 space-y-6">
                {
                  loadedGoogleCollections.map(({ config, bundle }) => (
                    <MilanMapPanel map={config}>
                      <GoogleMapsCollection embedUrl={bundle.embedUrl} title={config.title} />
                    </MilanMapPanel>
                  ))
                }
              </div>
            </div>
          ) : null
        }

        <div class="mt-10 space-y-10">
          {
            embeddedByCategory.map(({ category, embeds, external }) =>
              embeds.length > 0 || external.length > 0 ? (
                <div>
                  <h3 class="font-heading text-lg font-semibold text-text">{category}</h3>
                  <div class="mt-4 space-y-6">
                    {
                      embeds.map((config) => {
                        const loaded = embedById[config.id];
                        const datasetDate = loaded.points?.datasetModified
                          ? new Date(loaded.points.datasetModified).toLocaleDateString('en-GB', {
                              year: 'numeric',
                              month: 'long',
                              day: 'numeric',
                            })
                          : null;
                        const featureLabel =
                          config.geometryMode === 'lines'
                            ? 'segments'
                            : config.geometryMode === 'polygons'
                              ? 'areas'
                              : 'locations';
                        return (
                          <MilanMapPanel map={config} guideHref={config.guideHref}>
                            {loaded.points ? (
                              <>
                                <p class="mb-3 text-sm text-text-muted">
                                  <strong>{loaded.points.featureCount}</strong> {featureLabel}
                                  {datasetDate ? `: updated ${datasetDate}` : ''}. Tap{' '}
                                  {config.geometryMode === 'polygons' ? 'an area' : 'a feature'} for details and Google
                                  Maps directions.
                                </p>
                                <GeoJsonMap
                                  mapId={`map-${config.id}`}
                                  ariaLabel={config.title}
                                  geojson={loaded.points.geojson}
                                  lineGeojson={loaded.lines?.geojson}
                                  popupType={config.popupType}
                                  geometryMode={config.geometryMode}
                                  pointColor={config.pointColor}
                                  pointBorder={config.pointBorder}
                                  attributionHtml={`&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> | <a href="${config.datasetPage}">Comune di Milano open data</a> (CC BY)`}
                                />
                              </>
                            ) : (
                              <p class="rounded-md border border-border bg-background p-4 text-sm text-text-muted">
                                Map temporarily unavailable ({loaded.error}).{' '}
                                <a href={config.datasetPage}>Open dataset</a>.
                              </p>
                            )}
                          </MilanMapPanel>
                        );
                      })
                    }
                    {
                      external.length > 0 ? (
                        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                          {external.map((map) => (
                            <MilanMapPanel map={map} />
                          ))}
                        </div>
                      ) : null
                    }
                  </div>
                </div>
              ) : null,
            )
          }
        </div>
      </div>

      <div class="prose prose-lg mt-10 max-w-none prose-headings:font-heading prose-a:text-primary-light">
        <h2>More open data</h2>
        <p>
          The Comune publishes hundreds of geospatial datasets on{' '}
          <a href="https://dati.comune.milano.it/">dati.comune.milano.it</a>. Leaflet maps above use CKAN GeoJSON
          feeds; Google Maps sections embed public My Maps collections validated at build time.
        </p>

        <h2>Sources</h2>
        <ul>
          <li>
            <a href="https://giromilano.atm.it/assets/images/schema_rete_metro.jpg">ATM: Metro network schematic</a>
          </li>
          <li><a href="https://giromilano.atm.it/">ATM: GiroMilano route planner</a></li>
          <li>
            <a href="https://dati.comune.milano.it/web/portale-del-dato/w/mappa-dei-varchi-di-area-c-e-area-b-a-milano">
              Comune di Milano: Area C &amp; B story map
            </a>
          </li>
          <li><a href="https://www.farmacia-aperta.eu/">Federfarma Lombardia: Farmacia Aperta</a></li>
          <li><a href="https://www.amsa.it/it/milano/servizi/ricicleria">AMSA: Riciclerie</a></li>
        </ul>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
