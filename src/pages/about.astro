---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { brand } from '../config/brand';
import { communityJoinFormId, communityJoinUrl } from '../config/social-links';

const team = [
  { name: 'Guido', role: 'Founder · Nokia’s old motto was Connecting People - he made it a community' },
  { name: 'Andrea', role: 'Hiking & Outdoor · on Sundays, he always takes the scenic route' },
  { name: 'Mariana Clara', role: 'Cinema Club · she has a take ready when the lights come up' },
  { name: 'Thales', role: 'Boardgames · he keeps the table busy while he waits for Book Club to pick Dune' },
  { name: 'Ohi', role: 'Book Club · legend says he finished every book the club picked' },
  { name: 'Imane', role: 'Book Club · she shuts down spoilers before they leave the group chat' },
  { name: 'Anabel', role: 'Book Club · she picks the books people actually finish' },
];
---

<BaseLayout
  title="About"
  description={`${brand.name} publishes practical Milan guides for newcomers. New in Milan is the community behind the meetups — started in 2022.`}
>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">About</p>
      <h1 class="mt-3 font-heading text-h1 font-semibold text-text">About {brand.name} and New in Milan</h1>
      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">2022: from moving to Milan to building a community</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            In 2022, Guido moved to Milan to start a new chapter after living abroad, including in Belgium and Germany. The first step was building a community to connect people navigating the same transition.
          </p>
        </div>
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">New in Milan vs The Milan Post</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            New in Milan came first as a people-first space for meetups, friendships, and peer support. The Milan Post came later as the informative outlet: a practical layer of guides to complement what the community was already sharing.
          </p>
        </div>
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">What the New in Milan community does</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            Community remains the foundation: people meeting, sharing experiences, and helping each other settle in through interest-based groups and local activities.
          </p>
        </div>
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">What our guides cover</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            We focus on paperwork, residency, housing, healthcare, transport, and everyday life in Milan, with concise guides designed to be practical from day one.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Connect</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Find us online</h2>
      <p class="mt-3 max-w-2xl text-text-muted">
        Follow The Milan Post and join the New in Milan community on social media, events, updates, and peer support
        for life in Milan.
      </p>
      <div class="mt-6 max-w-xl">
        <SocialLinks showHeading={false} />
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={communityJoinUrl}
          data-tally-open={communityJoinFormId}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90"
        >
          Join New in Milan
        </a>
        <a
          href="/new-in-milan"
          class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg"
        >
          Explore New in Milan
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-background py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Team</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">New in Milan crew</h2>
      <p class="mt-3 max-w-2xl text-text-muted">
        Club leads and the founder behind the meetups.
      </p>

      <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {team.map((member) => (
          <article class="rounded-md border border-border bg-background p-5">
            <div class="flex items-center gap-4">
              <div class="flex size-14 shrink-0 items-center justify-center rounded-full bg-primary/10 text-sm font-bold text-primary">
                {member.name
                  .split(' ')
                  .slice(0, 2)
                  .map((part) => part[0])
                  .join('')}
              </div>
              <div>
                <h3 class="font-heading text-base font-semibold text-text">{member.name}</h3>
                <p class="text-sm text-text-muted">{member.role}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
