---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import { brand } from '../config/brand';
import {
  communityJoinFormId,
  communityJoinUrl,
  instagramEmbedUrls,
  lumaCalendarEmbedSrc,
  lumaCalendarUrl,
  socialLinks,
  tiktokProfileUrl,
  tiktokUsername,
} from '../config/social-links';
import nimCommunityLogo from '../assets/branding/nim-community.png';

/** Front-page guide stories: curated order for newcomers (NN/G: reveal content by example). */
const featuredGuideIds = [
  'moving-to-milan-complete-guide-students-job-seekers-professionals',
  'permesso-di-soggiorno-milan-newcomers',
  'cie-digital-id-for-expats-in-italy',
] as const;

const blogById = new Map(
  (await getCollection('blog', ({ data }) => !data.draft)).map((post) => [post.id, post]),
);

const featuredGuides = featuredGuideIds
  .map((id) => blogById.get(id))
  .filter((post): post is NonNullable<typeof post> => Boolean(post));

const instagramCanonicalUrls = instagramEmbedUrls
  .map((url) => {
    const match = url.match(/instagram\.com\/(?:[^/]+\/)?(p|reel)\/([^/?#]+)/);
    if (!match) return null;
    const [, type, shortcode] = match;
    return `https://www.instagram.com/${type}/${shortcode}/`;
  })
  .filter((url): url is string => Boolean(url));
---

<BaseLayout
  title={brand.name}
  description={brand.description}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: brand.name,
      description: brand.description,
      url: brand.url,
      logo: new URL('/the-milan-post-logo.png', brand.url).href,
      sameAs: socialLinks.map((link) => link.href),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: brand.name,
      description: brand.description,
      url: brand.url,
      publisher: { '@type': 'Organization', name: brand.name, url: brand.url },
    },
  ]}
>
  <Header slot="header" />

  <Hero />

  <section class="border-y border-border bg-background py-12 sm:py-14 md:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-topper font-bold uppercase tracking-widest text-primary">Start here</p>
          <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Guides people open first</h2>
          <p class="mt-2 max-w-2xl text-text-muted">
            Step-by-step admin guides for newcomers: start with the one that matches your situation.
          </p>
        </div>
        <a
          href="/guides"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-primary hover:text-primary-light"
        >
          Browse all guides
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      {
        featuredGuides.length > 0 ? (
          <ol class="mt-8 divide-y divide-border border-y border-border" aria-label="Featured guides">
            {featuredGuides.map((post, index) => (
              <li>
                <a
                  href={`/blog/${post.id}`}
                  class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-4 gap-y-1 py-5 transition-colors sm:gap-x-6 sm:py-6"
                >
                  <span class="font-heading text-h3 font-semibold tabular-nums text-primary/70 group-hover:text-primary">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="min-w-0">
                    <span class="block font-heading text-h3 font-semibold text-text group-hover:text-primary">
                      {post.data.title}
                    </span>
                    <span class="mt-1 block text-sm leading-relaxed text-text-muted sm:text-base">
                      {post.data.description}
                    </span>
                  </span>
                  <span class="hidden items-center gap-1 self-center text-sm font-semibold text-primary sm:inline-flex">
                    Read
                    <svg
                      class="size-4 transition-transform group-hover:translate-x-0.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <p class="mt-8 text-text-muted">
            Guides are on the way: browse the{' '}
            <a href="/guides" class="font-semibold text-primary hover:text-primary-light">
              guides hub
            </a>
            .
          </p>
        )
      }

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-muted">
        <a href="/paperwork" class="font-semibold text-primary hover:text-primary-light">
          Paperwork hub
        </a>
        <a href="/living-in-milan" class="font-semibold text-primary hover:text-primary-light">
          Living in Milan
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-12 sm:py-14 md:py-16">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <Image
          src={nimCommunityLogo}
          alt="New in Milan community logo"
          width={560}
          height={560}
          loading="lazy"
          decoding="async"
          class="mx-auto w-full max-w-[260px]"
        />
      </div>
      <div class="space-y-5 lg:col-span-2">
        <p class="text-topper font-bold uppercase tracking-widest text-primary">New in Milan community</p>
        <h2 class="font-heading text-h2 font-semibold text-text">Join New in Milan: events, interest groups, peer support</h2>
        <p class="text-text-muted leading-relaxed">
          We have an active international community in Milan with several subgroups where you can connect based on your interests:
        </p>
        <ul class="space-y-2 text-text-muted">
          <li><strong>NiM Social Club:</strong> For all NiM social meetups and events.</li>
          <li><strong>NiM Chit-Chat:</strong> Your go-to space for casual conversations, questions, and advice.</li>
          <li><strong>NiM Outdoor:</strong> For hiking, climbing, skiing, cycling, and other outdoor adventures.</li>
          <li><strong>NiM Book Club:</strong> Monthly meetups for book lovers.</li>
          <li><strong>NiM Sports:</strong> Organize and enjoy any sport in and around Milan.</li>
          <li><strong>NiM Games:</strong> For lovers of board games, bowling, quizzes, and more.</li>
        </ul>
        <div class="pt-2">
          <a
            href={communityJoinUrl}
            data-tally-open={communityJoinFormId}
            class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90"
          >
            Join the New in Milan community
          </a>
          <a
            href="/new-in-milan"
            class="ml-0 mt-3 inline-flex min-h-[44px] items-center justify-center rounded-md border border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg sm:ml-3 sm:mt-0"
          >
            Explore New in Milan
          </a>
        </div>
        <div class="pt-2">
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-text">Our socials</p>
          <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
            <li>
              <a href="https://www.facebook.com/groups/newinmilan" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-primary">
                <Image src="https://www.google.com/s2/favicons?domain=facebook.com&sz=64" alt="Facebook favicon" width={16} height={16} loading="lazy" />
                Facebook group
              </a>
            </li>
            <li>
              <a href="https://instagram.com/themilanpost" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-primary">
                <Image src="https://www.google.com/s2/favicons?domain=instagram.com&sz=64" alt="Instagram favicon" width={16} height={16} loading="lazy" />
                Instagram
              </a>
            </li>
            <li>
              <a href="https://www.tiktok.com/@themilanpost" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-primary">
                <Image src="https://www.google.com/s2/favicons?domain=tiktok.com&sz=64" alt="TikTok favicon" width={16} height={16} loading="lazy" />
                TikTok
              </a>
            </li>
            <li>
              <a href="https://linktr.ee/themilanpost" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-text-muted transition-colors hover:text-primary">
                <Image src="https://www.google.com/s2/favicons?domain=linktr.ee&sz=64" alt="Linktree favicon" width={16} height={16} loading="lazy" />
                Linktree
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-background py-12 sm:py-14 md:py-16" aria-labelledby="home-events-heading">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-topper font-bold uppercase tracking-widest text-primary">Events</p>
          <h2 id="home-events-heading" class="mt-2 font-heading text-h2 font-semibold text-text">
            Upcoming New in Milan meetups
          </h2>
          <p class="mt-2 max-w-2xl text-text-muted">
            Browse and RSVP on Luma. Accept optional embeds once to load the calendar automatically,
            or open it when you want.
          </p>
        </div>
        <a
          href="/new-in-milan#events"
          class="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-primary hover:text-primary-light"
        >
          New in Milan events
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      <div
        class="mt-6 overflow-hidden rounded-md border border-border bg-surface"
        data-click-embed
        data-embed-src={lumaCalendarEmbedSrc}
        data-embed-title="New in Milan events calendar on Luma"
        data-embed-class="block h-[400px] w-full sm:h-[450px]"
      >
        <div
          class="flex h-[400px] flex-col items-center justify-center gap-4 px-6 text-center sm:h-[450px]"
          data-click-embed-placeholder
        >
          <p class="max-w-md text-sm text-text-muted leading-relaxed">
            Luma may set cookies. Accept embeds in the site banner, load here, or{' '}
            <a href={lumaCalendarUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-primary hover:text-primary-light">
              open on Luma
            </a>.
          </p>
          <button
            type="button"
            class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg transition-opacity hover:opacity-90"
            data-click-embed-load
          >
            Load Luma calendar
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-background py-12 sm:py-14 md:py-16" data-social-embeds>
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Social</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Instagram, TikTok, and more</h2>
      <p class="mt-2 max-w-2xl text-text-muted">
        Instagram and TikTok embeds load after you accept optional embeds (or tap Load below). Profile
        links always work.
      </p>

      <div
        class="mt-6 rounded-md border border-border bg-surface p-5"
        data-social-embeds-placeholder
      >
        <p class="text-sm text-text-muted leading-relaxed">
          Official Instagram and TikTok widgets may set cookies. Accept once in the site banner, or
          load them here.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <button
            type="button"
            data-social-embeds-load
            class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg transition-opacity hover:opacity-90"
          >
            Load Instagram &amp; TikTok
          </button>
          {
            socialLinks.map(({ label, href }) => (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-[44px] items-center justify-center rounded-md border border-border bg-background px-4 py-2 text-sm font-semibold text-text hover:border-primary hover:text-primary"
              >
                {label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="mt-8 hidden" data-social-embeds-mount hidden aria-hidden="true">
        <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-2 md:gap-8">
          <div class="flex min-w-0 flex-col">
            <div class="flex items-end justify-between gap-3">
              <div>
                <p class="text-topper font-bold uppercase tracking-widest text-primary">Instagram</p>
                <h3 class="mt-2 font-heading text-h3 font-semibold text-text">Latest posts</h3>
              </div>
              <div class="flex shrink-0 items-center gap-2">
                <button
                  type="button"
                  id="ig-prev"
                  class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-full border border-border bg-background text-text transition-colors hover:border-primary hover:text-primary"
                  aria-label="Show previous Instagram previews"
                >
                  ←
                </button>
                <button
                  type="button"
                  id="ig-next"
                  class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-full border border-border bg-background text-text transition-colors hover:border-primary hover:text-primary"
                  aria-label="Show next Instagram previews"
                >
                  →
                </button>
              </div>
            </div>

            <div
              id="ig-carousel"
              class="mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            >
              {
                instagramCanonicalUrls.map((url) => (
                  <div class="ig-card w-[min(100%,280px)] min-w-[min(100%,280px)] max-w-[280px] shrink-0 snap-start overflow-hidden rounded-lg border border-border bg-white p-2">
                    <blockquote
                      class="instagram-media"
                      data-instgrm-permalink={url}
                      data-instgrm-version="14"
                      style="background:#FFF; border:0; border-radius:8px; box-shadow:none; margin:0; min-width:0; max-width:100%; width:100%;"
                    >
                      <a href={url} target="_blank" rel="noopener noreferrer">
                        View this Instagram post
                      </a>
                    </blockquote>
                  </div>
                ))
              }
            </div>

            <p class="mt-auto pt-4 text-sm text-text-muted">
              <a
                href="https://instagram.com/themilanpost"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-primary hover:text-primary-light"
              >
                @themilanpost on Instagram
              </a>
            </p>
          </div>

          <div class="flex min-w-0 flex-col">
            <div>
              <p class="text-topper font-bold uppercase tracking-widest text-primary">TikTok</p>
              <h3 class="mt-2 font-heading text-h3 font-semibold text-text">Community videos</h3>
            </div>

            <div class="mt-5 w-full overflow-hidden">
              <blockquote
                class="tiktok-embed"
                cite={tiktokProfileUrl}
                data-unique-id={tiktokUsername}
                data-embed-type="creator"
                style="max-width: 100%; min-width: 288px; width: 100%; margin: 0;"
              >
                <section>
                  <a target="_blank" href={`${tiktokProfileUrl}?refer=creator_embed`} rel="noopener noreferrer">
                    @{tiktokUsername}
                  </a>
                </section>
              </blockquote>
            </div>

            <p class="mt-auto pt-4 text-sm text-text-muted">
              <a
                href={tiktokProfileUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-primary hover:text-primary-light"
              >
                @{tiktokUsername} on TikTok
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
    <style is:inline>
      #ig-carousel .ig-card .instagram-media,
      #ig-carousel .ig-card .instagram-media iframe {
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
      }
      #ig-carousel .ig-card .instagram-media {
        margin: 0 !important;
      }
      .tiktok-embed iframe {
        max-width: 100% !important;
      }
    </style>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
      const setupCarousel = () => {
        const carousel = document.getElementById('ig-carousel');
        const prev = document.getElementById('ig-prev');
        const next = document.getElementById('ig-next');
        if (!(carousel instanceof HTMLElement) || !(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) {
          return;
        }
        const slideBy = () => Math.max(320, Math.floor(carousel.clientWidth * 0.9));
        prev.onclick = () => carousel.scrollBy({ left: -slideBy(), behavior: 'smooth' });
        next.onclick = () => carousel.scrollBy({ left: slideBy(), behavior: 'smooth' });
      };
      document.addEventListener('milanpost:social-embeds-ready', setupCarousel);
      document.addEventListener('astro:page-load', setupCarousel);
    })();
  </script>

  <Footer slot="footer" />
</BaseLayout>
