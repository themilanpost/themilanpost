---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { brand } from '../../../config/brand';

export async function getStaticPaths() {
  const posts = await getCollection('blogIt', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const enSlug = post.data.translationOf ?? post.id;
const alternates = [
  { hreflang: 'en', href: `${brand.url}/blog/${enSlug}/` },
  { hreflang: 'it', href: `${brand.url}/it/blog/${post.id}/` },
  { hreflang: 'x-default', href: `${brand.url}/blog/${enSlug}/` },
];
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  author={post.data.author}
  articleSlug={enSlug}
  lang="it"
  alternates={alternates}
>
  <Content />
</PostLayout>
