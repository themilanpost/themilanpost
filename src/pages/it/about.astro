---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { brand } from '../../config/brand';

const alternates = [
  { hreflang: 'en', href: `${brand.url}/about/` },
  { hreflang: 'it', href: `${brand.url}/it/about/` },
  { hreflang: 'x-default', href: `${brand.url}/about/` },
];
---

<BaseLayout
  title={`Chi siamo | ${brand.name}`}
  description={`${brand.name} pubblica guide pratiche su Milano: documenti, casa, trasporti e vita quotidiana, con fonti ufficiali.`}
  lang="it"
  ogLocale={brand.it.locale}
  alternates={alternates}
>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Chi siamo</p>
      <h1 class="mt-3 font-heading text-h1 font-semibold text-text">
        Chi è {brand.name}
      </h1>
      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">Guide pratiche su Milano</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            Pubblichiamo guide chiare su documenti, residenza, casa, sanità, trasporti e vita di
            tutti i giorni a Milano. Ogni testo punta a fonti ufficiali (Comune, Questura, Poste,
            Agenzia delle Entrate) e si aggiorna quando cambiano procedure o scadenze.
          </p>
        </div>
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">Per chi scrive queste pagine</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            Per chi vive a Milano o si trasferisce in città: studenti, lavoratori, famiglie e chi
            deve sbrigare una pratica senza perdersi tra moduli e portali.
          </p>
        </div>
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">Cosa trovi nelle guide</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            Ordine delle pratiche, CIE, TARI, permesso di soggiorno dove serve, e hub sulla vita
            quotidiana. Non è una guida turistica: è materiale operativo, passo passo.
          </p>
        </div>
        <div class="rounded-md border border-border bg-surface p-6">
          <h2 class="font-heading text-h3 font-semibold text-text">Correzioni e suggerimenti</h2>
          <p class="mt-3 text-text-muted leading-relaxed">
            Se noti un errore o un link ufficiale aggiornato, scrivici dal modulo contatti: leggiamo
            ogni messaggio.
          </p>
          <a
            href="/it/contact/"
            class="mt-3 inline-flex text-sm font-semibold text-primary hover:text-primary-light"
          >
            Vai ai contatti
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Resta in contatto</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Trovaci online</h2>
      <p class="mt-3 max-w-2xl text-text-muted">
        Segui {brand.name} per aggiornamenti sulle guide e sulla vita pratica a Milano.
      </p>
      <div class="mt-6 max-w-xl">
        <SocialLinks showHeading={false} />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
