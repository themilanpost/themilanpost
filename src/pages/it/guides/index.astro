---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import HubGuideCard from '../../../components/HubGuideCard.astro';
import { getCollection } from 'astro:content';
import { guidesHubIt } from '../../../config/guides-hub';
import { brand } from '../../../config/brand';
import { blogPath } from '../../../i18n/paths';

const { title, intro, sections } = guidesHubIt;

const posts = (await getCollection('blogIt', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const alternates = [
  { hreflang: 'en', href: `${brand.url}/guides/` },
  { hreflang: 'it', href: `${brand.url}/it/guides/` },
  { hreflang: 'x-default', href: `${brand.url}/guides/` },
];
---

<BaseLayout
  title={`${title} | ${brand.name}`}
  description={`${intro} Guide pratiche per vivere a Milano.`}
  lang="it"
  ogLocale={brand.it.locale}
  alternates={alternates}
>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">The Milan Post</p>
      <h1 class="mt-3 max-w-3xl font-heading text-h1 font-semibold text-text">{title}</h1>
      <p class="mt-4 max-w-2xl text-lead leading-relaxed text-text-muted">{intro}</p>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2" role="list" aria-label="Hub delle guide">
        {
          sections.map((section) => (
            <div role="listitem">
              <HubGuideCard
                label={section.label}
                title={section.title}
                description={section.description}
                href={section.href}
              />
            </div>
          ))
        }
      </div>

      <div id="all-guides" class="mt-14 scroll-mt-24">
        <h2 class="font-heading text-h2 font-semibold text-text">Tutte le guide</h2>
        <p class="mt-2 max-w-2xl text-sm text-text-muted">
          Guide lunghe in italiano: trasferirsi a Milano, permesso, CIE, TARI e altre.
        </p>

        <ul class="mt-8 divide-y divide-border border-y border-border">
          {
            posts.map((post) => (
              <li>
                <a
                  href={blogPath(post.id, 'it')}
                  class="group block py-5 transition-colors sm:py-6"
                >
                  <span class="block font-heading text-h3 font-semibold text-text group-hover:text-primary">
                    {post.data.title}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-text-muted sm:text-base">
                    {post.data.description}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
