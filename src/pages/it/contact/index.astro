---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { brand } from '../../../config/brand';
import { formspreeEndpoint } from '../../../config/social-links';

const formReady = Boolean(formspreeEndpoint);
const successUrl = new URL('/it/contact/success/', Astro.site ?? brand.url).href;

const alternates = [
  { hreflang: 'en', href: `${brand.url}/contact/` },
  { hreflang: 'it', href: `${brand.url}/it/contact/` },
  { hreflang: 'x-default', href: `${brand.url}/contact/` },
];
---

<BaseLayout
  title={`Contatti | ${brand.name}`}
  description={`Scrivi a ${brand.name} per domande, correzioni o collaborazioni. Leggiamo ogni messaggio.`}
  lang="it"
  ogLocale={brand.it.locale}
  alternates={alternates}
>
  <Header slot="header" />

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Contatti</p>
      <h1 class="mt-3 font-heading text-h1 font-semibold text-text">Contatta {brand.name}</h1>
      <p class="mt-4 max-w-2xl text-lead leading-relaxed text-text-muted">
        Domande su una guida, una correzione o una collaborazione? Usa il modulo qui sotto.
        Leggiamo ogni messaggio.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-10 lg:grid-cols-3">
        <div class="lg:col-span-2">
          {
            formReady ? (
              <form
                method="POST"
                action={formspreeEndpoint}
                class="relative space-y-5 rounded-md border border-border bg-surface p-6 sm:p-8"
              >
                <input type="hidden" name="_subject" value={`Modulo contatti: ${brand.name}`} />
                <input type="hidden" name="_next" value={successUrl} />
                <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
                  <label for="company-website">Sito aziendale</label>
                  <input
                    id="company-website"
                    type="text"
                    name="_gotcha"
                    tabindex="-1"
                    autocomplete="off"
                  />
                </div>

                <div>
                  <label for="name" class="block text-sm font-semibold text-text">
                    Nome
                  </label>
                  <input
                    id="name"
                    name="name"
                    type="text"
                    required
                    maxlength="120"
                    class="mt-2 w-full rounded-md border border-border bg-background px-4 py-3 text-text outline-none ring-primary focus:ring-2"
                  />
                </div>

                <div>
                  <label for="email" class="block text-sm font-semibold text-text">
                    Email
                  </label>
                  <input
                    id="email"
                    name="email"
                    type="email"
                    required
                    maxlength="200"
                    class="mt-2 w-full rounded-md border border-border bg-background px-4 py-3 text-text outline-none ring-primary focus:ring-2"
                  />
                </div>

                <div>
                  <label for="message" class="block text-sm font-semibold text-text">
                    Messaggio
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    required
                    rows="6"
                    maxlength="5000"
                    class="mt-2 w-full rounded-md border border-border bg-background px-4 py-3 text-text outline-none ring-primary focus:ring-2"
                  ></textarea>
                </div>

                <p class="text-sm text-text-muted leading-relaxed">
                  Vedi la{' '}
                  <a href="/it/privacy/" class="font-semibold text-primary hover:text-primary-light">
                    informativa privacy
                  </a>
                  . Usiamo Formspree per consegnare i messaggi; non pubblichiamo un indirizzo email
                  pubblico.
                </p>

                <button
                  type="submit"
                  class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90"
                >
                  Invia messaggio
                </button>
              </form>
            ) : (
              <div class="rounded-md border border-border bg-surface p-6 sm:p-8">
                <p class="text-text-muted leading-relaxed">
                  Il modulo non è ancora configurato. Imposta{' '}
                  <code class="text-sm text-text">PUBLIC_FORMSPREE_FORM_ID</code> in{' '}
                  <code class="text-sm text-text">.env</code>, poi ricostruisci il sito.
                </p>
              </div>
            )
          }
        </div>

        <aside class="space-y-4">
          <div class="rounded-md border border-border bg-surface p-5">
            <h2 class="font-heading text-lg font-semibold text-text">Come raggiungerci</h2>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">
              Usa il modulo in questa pagina. Non pubblichiamo un indirizzo email pubblico, per
              ridurre lo spam.
            </p>
          </div>
          <div class="rounded-md border border-border bg-surface p-5">
            <h2 class="font-heading text-lg font-semibold text-text">Chi siamo</h2>
            <p class="mt-2 text-sm text-text-muted leading-relaxed">
              Preferisci il contesto prima? Leggi chi siamo e di cosa parlano le guide.
            </p>
            <a
              href="/it/about/"
              class="mt-3 inline-flex text-sm font-semibold text-primary hover:text-primary-light"
            >
              Chi siamo — {brand.name}
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
