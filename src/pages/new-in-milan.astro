---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import nimCommunityLogo from '../assets/branding/nim-community.png';
import {
  communityJoinFormId,
  communityJoinUrl,
  lumaCalendarEmbedSrc,
  lumaCalendarUrl,
} from '../config/social-links';
import outdoor01 from '../assets/new-in-milan/outdoor/outdoor-01.jpg';import outdoor02 from '../assets/new-in-milan/outdoor/outdoor-02.jpg';
import outdoor04 from '../assets/new-in-milan/outdoor/outdoor-04.jpg';
import outdoor05 from '../assets/new-in-milan/outdoor/outdoor-05.jpg';
import outdoor06 from '../assets/new-in-milan/outdoor/outdoor-06.jpg';
import outdoor07 from '../assets/new-in-milan/outdoor/outdoor-07.jpg';
import outdoor08 from '../assets/new-in-milan/outdoor/outdoor-08.jpg';
import outdoor09 from '../assets/new-in-milan/outdoor/outdoor-09.jpg';
import outdoor10 from '../assets/new-in-milan/outdoor/outdoor-10.jpg';

const outdoorImages = [
  outdoor01,
  outdoor02,
  outdoor04,
  outdoor05,
  outdoor06,
  outdoor07,
  outdoor08,
  outdoor09,
  outdoor10,
];

/** Recent / discussed NiM Book Club titles (covers via Open Library). */
const bookClubReads = [
  { title: 'The Vegetarian', author: 'Han Kang', isbn: '9781101906118' },
  { title: '1984', author: 'George Orwell', isbn: '9780451524935' },
  {
    title: 'The Unbearable Lightness of Being',
    author: 'Milan Kundera',
    isbn: '9780060932138',
  },
  {
    title: 'And Then There Were None',
    author: 'Agatha Christie',
    isbn: '9780062073488',
  },
  {
    title: 'The Song of Achilles',
    author: 'Madeline Miller',
    isbn: '9780062060624',
  },
  { title: 'Stag Dance', author: 'Torrey Peters', isbn: '9780593595640' },
  {
    title: 'Do Androids Dream of Electric Sheep?',
    author: 'Philip K. Dick',
    isbn: '9780345404473',
  },
  { title: 'Piranesi', author: 'Susanna Clarke', isbn: '9781635577808' },
  { title: 'Thousand Cranes', author: 'Yasunari Kawabata', isbn: '9780679762652' },
  {
    title: 'The Palace of Illusions',
    author: 'Chitra Banerjee Divakaruni',
    isbn: '9781400096206',
  },
];
---

<BaseLayout
  title="New in Milan"
  description="New in Milan (NiM): join the international community — interest groups, outdoor meetups, and the events calendar."
>
  <Header slot="header" />

  <section class="bg-background py-14 sm:py-18 md:py-22">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-[0.25em] text-primary">New in Milan</p>
      <h1 class="mt-4 max-w-4xl font-heading text-display font-semibold leading-tight text-text">
        A welcoming international community in Milan
      </h1>
      <p class="mt-5 max-w-3xl text-lead leading-relaxed text-text-muted">
        New in Milan (NiM) connects people who are building life in Milan through social events, interest-based groups, and practical peer support.
      </p>
    </div>
  </section>

  <section class="border-y border-border bg-surface py-12 sm:py-14">
    <div class="mx-auto grid max-w-site grid-cols-1 gap-8 px-4 sm:px-6 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <Image
          src={nimCommunityLogo}
          alt="New in Milan logo"
          width={560}
          height={560}
          loading="lazy"
          decoding="async"
          class="mx-auto w-full max-w-[240px]"
        />
      </div>
      <div class="space-y-4 lg:col-span-2">
        <h2 class="font-heading text-h2 font-semibold text-text">Community subgroups</h2>
        <ul class="space-y-2 text-text-muted">
          <li><strong>NiM Social Club:</strong> Social meetups and community events.</li>
          <li><strong>NiM Chit-Chat:</strong> Casual conversations, questions, and practical advice.</li>
          <li><strong>NiM Outdoor:</strong> Hiking, climbing, skiing, cycling, and adventures.</li>
          <li><strong>NiM Book Club:</strong> Monthly meetups for readers.</li>
          <li><strong>NiM Sports:</strong> Sports activities in and around Milan.</li>
          <li><strong>NiM Games:</strong> Board games, quizzes, bowling, and more.</li>
        </ul>
        <a
          href={communityJoinUrl}
          data-tally-open={communityJoinFormId}
          class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-6 py-3 text-base font-bold text-accent-fg transition-opacity hover:opacity-90"
        >
          Join the community
        </a>
      </div>
    </div>
  </section>

  <section id="events" class="border-t border-border bg-background py-12 sm:py-14 scroll-mt-24">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">Events</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Upcoming on Luma</h2>
      <p class="mt-3 max-w-2xl text-text-muted">
        Browse and RSVP to New in Milan events. Accept optional embeds once to load the calendar
        automatically, or load it here.
      </p>
      <div
        class="mt-6 overflow-hidden rounded-md border border-border bg-surface"
        data-click-embed
        data-embed-src={lumaCalendarEmbedSrc}
        data-embed-title="New in Milan events calendar on Luma"
        data-embed-class="block h-[450px] w-full"
      >
        <div
          class="flex h-[450px] flex-col items-center justify-center gap-4 px-6 text-center"
          data-click-embed-placeholder
        >
          <p class="max-w-md text-sm text-text-muted leading-relaxed">
            Luma may set cookies. Use the site banner, load here, or{' '}
            <a
              href={lumaCalendarUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-primary hover:text-primary-light"
            >
              open on Luma
            </a>.
          </p>
          <button
            type="button"
            class="inline-flex min-h-[44px] items-center justify-center rounded-md bg-accent px-5 py-2.5 text-sm font-bold text-accent-fg transition-opacity hover:opacity-90"
            data-click-embed-load
          >
            Load Luma calendar
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 sm:py-14 md:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">NiM Outdoor</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Outdoor chapter</h2>
      <p class="mt-3 max-w-2xl text-text-muted">
        We organize day trips and weekends for hiking, climbing, skiing, cycling, and other outdoor
        adventures around Northern Italy: lakes, foothills, and Alpine trails within easy reach of Milan.
        Pace and difficulty vary by outing, so beginners and regulars both show up. Bring suitable shoes
        and layers, RSVP on the event when it is posted, and expect a social group that walks, eats, and
        gets home together. Photos below are from recent Outdoor days.
      </p>

      <div class="mt-5 flex items-center justify-end gap-2">
        <button
          type="button"
          id="nim-prev"
          class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-full border border-border bg-background text-text transition-colors hover:border-primary hover:text-primary"
          aria-label="Show previous outdoor photos"
        >
          ←
        </button>
        <button
          type="button"
          id="nim-next"
          class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-full border border-border bg-background text-text transition-colors hover:border-primary hover:text-primary"
          aria-label="Show next outdoor photos"
        >
          →
        </button>
      </div>

      <div
        id="nim-carousel"
        class="mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {outdoorImages.map((img, index) => (
          <div class="min-w-[240px] max-w-[240px] snap-start overflow-hidden rounded-lg border border-border bg-surface">
            <Image
              src={img}
              alt={`NiM Outdoor photo ${index + 1}`}
              width={240}
              height={180}
              loading="lazy"
              decoding="async"
              class="h-[180px] w-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-surface py-12 sm:py-14 md:py-16">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <p class="text-topper font-bold uppercase tracking-widest text-primary">NiM Book Club</p>
      <h2 class="mt-2 font-heading text-h2 font-semibold text-text">Book Club chapter</h2>
      <p class="mt-3 max-w-2xl text-text-muted">
        We meet about once a month, usually on a Sunday afternoon, to talk through one novel together.
        Expect an open discussion, not essays or quizzes: bring your take, skip what you could not finish,
        and stay for coffee and company. Sessions are often hosted at independent bookshops in Milan
        (for example Libreria Verso on Corso di Porta Ticinese). Titles below are books we have already
        read or lined up.
      </p>

      <div class="mt-5 flex items-center justify-end gap-2">
        <button
          type="button"
          id="nim-books-prev"
          class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-full border border-border bg-background text-text transition-colors hover:border-primary hover:text-primary"
          aria-label="Show previous book club titles"
        >
          ←
        </button>
        <button
          type="button"
          id="nim-books-next"
          class="inline-flex min-h-[36px] min-w-[36px] items-center justify-center rounded-full border border-border bg-background text-text transition-colors hover:border-primary hover:text-primary"
          aria-label="Show next book club titles"
        >
          →
        </button>
      </div>

      <div
        id="nim-books-carousel"
        class="mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-2 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {
          bookClubReads.map(({ title, author, isbn }) => (
            <article class="flex min-w-[200px] max-w-[200px] snap-start flex-col overflow-hidden rounded-lg border border-border bg-background">
              <div class="aspect-[2/3] bg-surface">
                <img
                  src={`https://covers.openlibrary.org/b/isbn/${isbn}-L.jpg`}
                  alt=""
                  width={200}
                  height={300}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="flex flex-1 flex-col gap-1 p-3">
                <h3 class="font-heading text-sm font-semibold leading-snug text-text">{title}</h3>
                <p class="text-xs text-text-muted">{author}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <script is:inline data-astro-rerun>
    (() => {
      const wireCarousel = (carouselId, prevId, nextId) => {
        const carousel = document.getElementById(carouselId);
        const prev = document.getElementById(prevId);
        const next = document.getElementById(nextId);
        if (!(carousel instanceof HTMLElement) || !(prev instanceof HTMLButtonElement) || !(next instanceof HTMLButtonElement)) {
          return;
        }

        const slideBy = () => Math.max(220, Math.floor(carousel.clientWidth * 0.85));
        prev.onclick = () => carousel.scrollBy({ left: -slideBy(), behavior: 'smooth' });
        next.onclick = () => carousel.scrollBy({ left: slideBy(), behavior: 'smooth' });
      };

      const setupCarouselControls = () => {
        wireCarousel('nim-carousel', 'nim-prev', 'nim-next');
        wireCarousel('nim-books-carousel', 'nim-books-prev', 'nim-books-next');
      };

      document.addEventListener('astro:page-load', setupCarouselControls);
      setupCarouselControls();
    })();
  </script>

  <Footer slot="footer" />
</BaseLayout>
